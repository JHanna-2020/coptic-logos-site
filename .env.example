# Where the beta signup form posts.
#
# Any service that accepts a plain HTML form POST works. Two good options:
#   Buttondown  https://buttondown.email   (a real mailing list, free under 100 subscribers)
#   Formspree   https://formspree.io       (just collects submissions, free tier ~50/mo)
#
# Leave this unset and the form falls back to a mailto: link, which still works.
PUBLIC_SIGNUP_ENDPOINT=

# Shown in the footer and used by the mailto fallback.
PUBLIC_CONTACT_EMAIL=hello@copticlogos.app
