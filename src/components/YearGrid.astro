---
import {
  COPTIC_MONTHS,
  toCoptic,
  monthLengths,
  dayOfYear,
  daysInYear,
  isLeapYear,
} from '../lib/coptic';

// Computed once, at build time. Rebuild the site and the grid moves forward.
const today = toCoptic(new Date());
const lengths = monthLengths(today.year);
const elapsed = dayOfYear(today);
const total = daysInYear(today.year);

const months = COPTIC_MONTHS.map((name, index) => ({
  name,
  days: Array.from({ length: lengths[index] }, (_, d) => {
    const ordinal = index * 30 + d + 1;
    return {
      state: ordinal < elapsed ? 'past' : ordinal === elapsed ? 'today' : 'ahead',
    };
  }),
}));
---

<section class="section section--ruled" aria-labelledby="year-heading">
  <div class="shell">
    <p class="eyebrow">The Coptic year</p>
    <h2 class="h2" id="year-heading">
      Twelve months of thirty days,<br />then a little month of {isLeapYear(today.year) ? 6 : 5}.
    </h2>
    <p class="lede">
      Every dot is one day of the year {today.year} of the Martyrs. {elapsed} have
      passed. The app keeps this calendar so you always know which fast you are
      in, whose feast it is, and what the Church is reading today.
    </p>

    <ol class="year" aria-hidden="true">
      {
        months.map((month, i) => (
          <li class="year__month" style={`--row: ${i}`}>
            <span class="year__name">{month.name}</span>
            <span class="year__days">
              {month.days.map((day) => (
                <span class={`dot dot--${day.state}`} />
              ))}
            </span>
          </li>
        ))
      }
    </ol>

    <p class="year__caption">
      <span class="year__marker" aria-hidden="true"></span>
      Today is day {elapsed} of {total}.
    </p>
  </div>
</section>

<style>
  .year {
    list-style: none;
    margin: clamp(2.5rem, 6vw, 4rem) 0 1.5rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(0.3rem, 0.9vw, 0.55rem);
  }

  .year__month {
    display: grid;
    /* Wide enough for "Pi Kogi Enavot", the longest month name — a narrower
       track lets it hang out past the left edge of every other row. */
    grid-template-columns: 9.75rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    animation: settle 0.7s var(--ease) backwards;
    animation-delay: calc(var(--row) * 45ms);
  }

  .year__name {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--linen-faint);
    text-align: right;
    white-space: nowrap;
  }

  /* Always 30 columns, so the 5-day month ends up visibly short — which is the
     point. A grid that stretched it to full width would hide the structure. */
  .year__days {
    display: grid;
    grid-template-columns: repeat(30, 1fr);
    gap: clamp(0.15rem, 0.55vw, 0.4rem);
  }

  .dot {
    aspect-ratio: 1;
    border-radius: 50%;
    transition: transform 0.18s var(--ease), background 0.18s var(--ease);
  }

  .dot--past {
    background: var(--linen);
    opacity: 0.38;
  }

  .dot--ahead {
    background: var(--night-line);
  }

  .dot--today {
    background: var(--saffron);
    box-shadow:
      0 0 0 2px var(--night),
      0 0 0 4px rgba(220, 166, 70, 0.55),
      0 0 14px 2px rgba(220, 166, 70, 0.35);
  }

  .year__days:hover .dot:hover {
    transform: scale(1.9);
    background: var(--linen);
    opacity: 1;
  }

  .year__caption {
    margin: 0;
    padding-left: 10.75rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--linen-soft);
  }

  .year__marker {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--saffron);
    flex: none;
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(0.6rem);
    }
  }

  @media (max-width: 44rem) {
    .year__month {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }

    .year__name {
      text-align: left;
    }

    .year {
      gap: 0.85rem;
    }

    .year__caption {
      padding-left: 0;
    }
  }
</style>
