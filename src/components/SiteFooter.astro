---
import SignupForm from './SignupForm.astro';
import { CONTACT_EMAIL } from '../config';

const contact = CONTACT_EMAIL;
const year = new Date().getFullYear();
---

<section class="closing section--ruled" aria-labelledby="closing-heading">
  <div class="shell">
    <h2 class="closing__title" id="closing-heading">
      Built slowly,<br />in one parish.
    </h2>
    <p class="closing__body">
      I am building this because I could not stay consistent on my own. The
      first version is small on purpose. If you want to try it early and tell
      me what is wrong with it, leave your email.
    </p>
    <SignupForm />
  </div>
</section>

<footer class="footer">
  <div class="shell footer__inner">
    <p class="footer__disclaimer">
      <strong class="footer__strong">Coptic Logos is an independent project.</strong>
      It is not an official publication of the Coptic Orthodox Church, and
      nothing in it should be taken as a ruling of the Church or a substitute
      for your father of confession or your parish.
    </p>
    <p class="footer__meta">
      <a class="footer__link" href={`mailto:${contact}`}>{contact}</a>
      <span class="footer__sep" aria-hidden="true">·</span>
      <span>© {year}</span>
      <span class="footer__sep" aria-hidden="true">·</span>
      <span class="coptic footer__coptic">ⲡⲓⲗⲟⲅⲟⲥ</span>
    </p>
  </div>
</footer>

<style>
  .closing {
    padding-block: clamp(4.5rem, 11vw, 9rem);
    border-top: 1px solid var(--night-line);
  }

  .closing__title {
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 7.5vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  .closing__body {
    margin: 0;
    max-width: var(--measure);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--linen-soft);
  }

  .footer {
    padding-block: 2.5rem 3.5rem;
    border-top: 1px solid var(--night-line);
  }

  .footer__inner {
    display: grid;
    gap: 1.25rem;
  }

  .footer__disclaimer {
    margin: 0;
    max-width: 42rem;
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--linen-faint);
  }

  .footer__strong {
    color: var(--linen-soft);
    font-weight: 700;
  }

  .footer__meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--linen-faint);
  }

  .footer__link {
    color: var(--linen-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--night-line);
  }

  .footer__link:hover {
    border-bottom-color: var(--saffron);
  }

  .footer__coptic {
    color: var(--saffron);
    opacity: 0.6;
  }

  .footer__sep {
    opacity: 0.5;
  }
</style>
